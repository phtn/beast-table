import { useState } from 'octane'
import ExplorerTable from './components/ExplorerTable.btsx'
import AnalyticsTable from './components/AnalyticsTable.btsx'
import StreamTable from './components/StreamTable.btsx'

module
  type PanelId = 'explorer' | 'analytics' | 'stream'

  interface Panel {
    id: PanelId
    label: string
    shortLabel: string
  }

  const panels: Panel[] = [
    { id: 'explorer', label: '50k Explorer', shortLabel: 'Explorer' },
    { id: 'analytics', label: 'Grouped Analytics', shortLabel: 'Analytics' },
    { id: 'stream', label: 'Live Stream', shortLabel: 'Stream' },
  ]

props _: Record<string, never>
setup const [activeId, setActiveId] = useState<PanelId>('explorer')

main.app-shell
  section.showcase(aria-labelledby='showcase-title')
    header.showcase-header
      div.brand
        span.brand-mark(aria-hidden='true')
          img(src='/beast.svg' alt='beast-logo')
        div
          p Built with Beast
          h2(className='text-[#ff415a]') @octanejs/tanstack-table
      nav.panel-tabs(aria-label='Table examples' role='tablist')
        each panel in panels key panel.id
          button(
            ~ type='button'
            ~ id={`tab-${panel.id}`}
            ~ role='tab'
            ~ aria-controls='table-panel'
            ~ aria-selected={activeId === panel.id}
            ~ className={activeId === panel.id ? 'panel-tab active' : 'panel-tab'}
            ~ onClick={() => setActiveId(panel.id)}
            ~ )
            span.tab-long #{panel.label}
            span.tab-short #{panel.shortLabel}
      div.binding-badge
        span.binding-pulse(aria-hidden='true')
        | v9 binding

    section#table-panel(
      ~ role='tabpanel'
      ~ aria-live='polite'
      ~ aria-labelledby={`tab-${activeId}`}
      ~ className='panel-surface'
      ~ )
      if activeId === 'explorer'
        ExplorerTable
      elseif activeId === 'analytics'
        AnalyticsTable
      else
        StreamTable

    footer.showcase-footer
      p
        span.footer-dot(aria-hidden='true')
        | Deterministic data by Faker.js
      p Headless models · atom-level state · bounded DOM
