import { lazy, useEffect, useState } from 'octane'
import {PanelTabs} from '@/components'
import {Button, ProgressBar} from '@/components/ui'
import { formatCompact, prepareAnalyticsRows, ROW_COUNT, seedPerformanceRows } from './data'
import type { AnalyticsRow, PerformanceRow, SeedRowCount } from './data'
import { navigate, panelRoutes, usePanelRoute } from './router'

module
  type SeedPhase = 'preparing' | 'loading' | 'seeding' | 'ready' | 'error'
  type AnalyticsPhase = 'idle' | 'indexing' | 'ready' | 'error'

  interface SeedState {
    completed: number
    elapsedMs: number
    error: string | null
    phase: SeedPhase
    rows: ReadonlyArray<PerformanceRow> | null
    total: number
  }

  interface AnalyticsState {
    completed: number
    elapsedMs: number
    error: string | null
    phase: AnalyticsPhase
    rows: ReadonlyArray<AnalyticsRow> | null
    total: number
  }

  const placeholderRows = [0, 1, 2, 3, 4, 5]
  const AnalyticsTable = lazy(() => import('./components/AnalyticsTable.btsx'))
  const ExplorerTable = lazy(() => import('./components/ExplorerTable.btsx'))
  const StreamTable = lazy(() => import('./components/StreamTable.btsx'))

  const createInitialSeedState = (total: SeedRowCount = ROW_COUNT): SeedState => ({
    completed: 0,
    elapsedMs: 0,
    error: null,
    phase: 'preparing',
    rows: null,
    total,
  })

  const createInitialAnalyticsState = (total = ROW_COUNT): AnalyticsState => ({
    completed: 0,
    elapsedMs: 0,
    error: null,
    phase: 'idle',
    rows: null,
    total,
  })

props _: Record<string, never>
setup
  const activeId = usePanelRoute()
  const [seedAttempt, setSeedAttempt] = useState(0)
  const [seedCount, setSeedCount] = useState<SeedRowCount>(ROW_COUNT)
  const [seedState, setSeedState] = useState<SeedState>(createInitialSeedState)
  const [analyticsAttempt, setAnalyticsAttempt] = useState(0)
  const [analyticsState, setAnalyticsState] = useState<AnalyticsState>(createInitialAnalyticsState)
  const [tablesMounted, setTablesMounted] = useState(false)

  useEffect(() => {
    const controller = new AbortController()
    let mountTimer: number | undefined

    setTablesMounted(false)
    setSeedState(createInitialSeedState(seedCount))
    setAnalyticsState(createInitialAnalyticsState(seedCount))

    seedPerformanceRows({
      rowCount: seedCount,
      signal: controller.signal,
      onProgress: (progress) => {
        setSeedState({
          ...progress,
          error: null,
          rows: null,
        })
      },
    })
      .then(({ elapsedMs, rows }) => {
        if (controller.signal.aborted) return

        setSeedState({
          completed: rows.length,
          elapsedMs,
          error: null,
          phase: 'ready',
          rows,
          total: rows.length,
        })
        mountTimer = globalThis.setTimeout(() => setTablesMounted(true), 0)
      })
      .catch((error: unknown) => {
        if (controller.signal.aborted) return

        setSeedState((current) => ({
          ...current,
          error: error instanceof Error ? error.message : 'The dataset could not be seeded.',
          phase: 'error',
          rows: null,
        }))
      })

    return () => {
      controller.abort()
      if (mountTimer !== undefined) globalThis.clearTimeout(mountTimer)
    }
  }, [seedAttempt, seedCount])

  useEffect(() => {
    if (activeId !== 'analytics' || seedState.rows === null) return

    const controller = new AbortController()
    const sourceRows = seedState.rows

    setAnalyticsState((current) => current.rows === null
      ? createInitialAnalyticsState(sourceRows.length)
      : current)

    prepareAnalyticsRows(sourceRows, {
      signal: controller.signal,
      onProgress: (progress) => {
        setAnalyticsState({
          ...progress,
          error: null,
          rows: null,
        })
      },
    })
      .then(({ elapsedMs, rows, sourceRowCount }) => {
        if (controller.signal.aborted) return

        setAnalyticsState({
          completed: sourceRowCount,
          elapsedMs,
          error: null,
          phase: 'ready',
          rows,
          total: sourceRowCount,
        })
      })
      .catch((error: unknown) => {
        if (controller.signal.aborted) return

        setAnalyticsState((current) => ({
          ...current,
          error: error instanceof Error ? error.message : 'The analytics index could not be prepared.',
          phase: 'error',
          rows: null,
        }))
      })

    return () => controller.abort()
  }, [activeId, seedState.rows, analyticsAttempt])

  const showAnalyticsProgress = activeId === 'analytics' && seedState.phase === 'ready'
  const progressState = showAnalyticsProgress ? analyticsState : seedState
  const progressPercent = progressState.total === 0
    ? 0
    : Math.min(100, (progressState.completed / progressState.total) * 100)
  const progressRate = progressState.elapsedMs > 0
    ? progressState.completed / (progressState.elapsedMs / 1_000)
    : 0
  const progressTitle = showAnalyticsProgress
    ? analyticsState.phase === 'ready'
      ? 'Ready'
      : analyticsState.phase === 'error'
        ? 'Indexing interrupted'
        : analyticsState.phase === 'indexing'
          ? 'Indexing analytics'
          : 'Preparing analytics'
    : seedState.phase === 'ready'
      ? 'Ready'
      : seedState.phase === 'error'
        ? 'Seeding Interrupted'
        : seedState.phase === 'seeding'
          ? 'Seeding'
          : seedState.phase === 'loading'
            ? 'Loading Faker.js'
            : 'Preparing dataset'
  const progressDetail = showAnalyticsProgress
    ? analyticsState.phase === 'ready'
      ? `${analyticsState.completed.toLocaleString()} rows indexed into ${analyticsState.rows?.length.toLocaleString() ?? 0} cached buckets in ${(analyticsState.elapsedMs / 1_000).toFixed(1)}s`
      : analyticsState.phase === 'error'
        ? analyticsState.error ?? 'Unknown analytics indexing error'
        : analyticsState.phase === 'idle'
          ? 'Starting after the analytics panel paints'
          : `${analyticsState.completed.toLocaleString()} of ${analyticsState.total.toLocaleString()} rows · ${formatCompact(progressRate)}/sec`
    : seedState.phase === 'ready'
      ? `${seedState.completed.toLocaleString()} rows seeded in ${(seedState.elapsedMs / 1_000).toFixed(1)}s · cached for this session`
      : seedState.phase === 'error'
        ? seedState.error ?? 'Unknown seeding error'
        : seedState.phase === 'loading'
          ? 'The interface is ready while the generator loads'
          : seedState.phase === 'preparing'
            ? 'Starting after the first paint'
            : `${seedState.completed.toLocaleString()} of ${seedState.total.toLocaleString()} rows · ${formatCompact(progressRate)}/sec`
  const progressReady = progressState.phase === 'ready'
  const progressError = progressState.phase === 'error'
  const retryProgress = () => {
    if (showAnalyticsProgress) {
      setAnalyticsAttempt((value) => value + 1)
    } else {
      setSeedAttempt((value) => value + 1)
    }
  }

main(
  ~ className='grid min-h-screen place-items-center p-[clamp(0px,3.5vw,0px)] max-[680px]:[place-items:start_center] max-[680px]:p-0 [&_select:focus-visible]:outline-[0px] [&_select:focus-visible]:outline-solid [&_select:focus-visible]:outline-[#6da5473d] [&_select:focus-visible]:outline-offset-2'
  ~ )
  section(
    ~ className='w-[min(100%,1480px)] overflow-hidden bg-background'
    ~ aria-labelledby='showcase-title'
    ~ )
    header(className='grid grid-cols-[minmax(210px,1fr)_auto] items-center gap-6 px-6 py-0 max-[1050px]:grid-cols-[1fr_auto]')
      div(className='flex min-w-0 items-center gap-2.5')
        span(className='grid shrink-0 place-items-center rounded-full' aria-hidden='true')
          img(className='size-[32px] md:size-8' src='/beast.svg' alt='beast-logo')
        div(className='flex items-center gap-3')
          h2(className='font-sans flex items-center gap-3')
            span(className='') Beast
            span(className='opacity-60') /
            span(className='text-[#ff415a]') 4 Octane Bindings
      PanelTabs(
        ~ activeId={activeId}
        ~ items={panelRoutes}
        ~ onNavigate={navigate}
        ~ )
    section#table-panel(
      ~ aria-live='polite'
      ~ aria-labelledby={`route-${activeId}`}
      ~ className='relative mx-0 rounded-[1.40em] md:rounded-t-[1.41em] rounded-b-[0.5em] border border-input bg-muted p-4 sm:px-2 pb-2 pt-10'
      ~ )
      div(className='absolute -top-3.25 rounded-[-4px] -left-3.25 border-r border-input bg-background size-6.5 rotate-45')
      div(className='absolute -top-3.25 rounded-[-4px] -right-3.25 border-l border-input bg-background size-6.5 -rotate-45')
      div(
        ~
        ~ role='status'
        ~ aria-live='polite'
        ~ )
        div(className='flex min-w-0 items-center gap-2')
          span(
            ~ className={`size-2 shrink-0 rounded-full motion-reduce:animate-none ${progressReady ? 'opacity-0' : progressError ? 'bg-octane animate-pulse' : 'bg-[#ff415a] animate-pulse'}`}
            ~ aria-hidden='true'
            ~ )
          div(className='grid min-w-0 gap-0.75')
            b(className='text-2xs text-[#292e28]') #{progressTitle} in #{(progressState.elapsedMs / 1_000).toFixed(1)}s
        ProgressBar(
          ~ className='max-[680px]:col-span-full max-[680px]:row-start-2'
          ~ label={showAnalyticsProgress ? 'Analytics indexing progress' : 'Dataset seeding progress'}
          ~ value={progressPercent}
          ~ tone={progressReady ? 'success' : progressError ? 'error' : 'active'}
          ~ )
        div(className='grid min-w-[52px] gap-0.5 text-right max-[680px]:col-start-2 max-[680px]:row-start-1')
          b(className='font-mono text-[11px] tabular-nums text-[#363b35]') #{progressPercent.toFixed(0)}%

        if progressError
          Button(
            ~ type='button'
            ~ variant='danger'
            ~ size='none'
            ~ className='h-8 px-3 text-[9px] font-[750] max-[680px]:col-span-full max-[680px]:justify-self-start'
            ~ onClick={retryProgress}
            ~ ) Retry

      if seedState.rows === null || !tablesMounted
        section(className='grid min-h-[min(610px,70vh)] grid-cols-[minmax(260px,0.7fr)_minmax(420px,1.3fr)] items-center gap-[clamp(30px,6vw,90px)] overflow-hidden rounded-[18px] border border-[rgba(25,31,24,0.065)] bg-[#fcfdfb] p-[clamp(34px,6vw,82px)] max-[1050px]:grid-cols-[minmax(240px,0.8fr)_minmax(360px,1.2fr)] max-[1050px]:gap-[35px] max-[1050px]:px-[34px] max-[1050px]:py-11 max-[680px]:min-h-[560px] max-[680px]:grid-cols-1 max-[680px]:gap-8 max-[680px]:px-5 max-[680px]:pb-[30px] max-[680px]:pt-[38px]' aria-labelledby='seed-stage-title')
          div(className='max-w-[440px]')
            h2#seed-stage-title(className='m-0 max-w-[440px] text-[clamp(20px,4vw,36px)] font-[590] leading-[1.02] tracking-[-0.055em] text-[#20241f]') #{seedState.phase === 'error' ? 'The dataset needs another try' : 'Fetching data...'}
            p(className='mb-0 mt-[18px] max-w-[390px] text-[13px] leading-[1.6] text-[#7c8379]') #{seedState.phase === 'error' ? 'Retry the deterministic seed without reloading the page.' : 'Rows are created in small chunks and progress stay responsive.'}
          div(className='rotate-[0.8deg] overflow-hidden rounded-[15px] border border-[#e2e6df] bg-white shadow-[0_22px_50px_rgba(40,49,37,0.08)] max-[680px]:w-[720px] max-[680px]:max-w-none' aria-hidden='true')
            div(className='grid min-h-10 grid-cols-[1.5fr_1fr_0.8fr_0.65fr_0.7fr] items-center gap-[18px] border-b border-[#edf0eb] bg-[#f5f7f3] px-[18px] [&_span]:block [&_span]:h-1.5 [&_span]:w-[56%] [&_span]:overflow-hidden [&_span]:rounded-full [&_span]:bg-[#dfe3dc]')
              span
              span
              span
              span
              span
            each row in placeholderRows key row
              div(className="grid min-h-[52px] grid-cols-[1.5fr_1fr_0.8fr_0.65fr_0.7fr] items-center gap-[18px] border-b border-[#edf0eb] px-[18px] last:border-b-0 [&_span]:block [&_span]:h-[7px] [&_span]:overflow-hidden [&_span]:rounded-full [&_span]:bg-[#e8ebe6] [&_span]:after:block [&_span]:after:h-full [&_span]:after:w-[45%] [&_span]:after:animate-pulse [&_span]:after:bg-[linear-gradient(90deg,transparent,rgba(255,255,255,0.85),transparent)] [&_span]:after:content-[''] [&_span:first-child]:h-2.5 [&_span:first-child]:w-[88%] [&_span:nth-child(2)]:w-[74%] [&_span:nth-child(3)]:w-[65%] [&_span:nth-child(4)]:w-[82%] [&_span:nth-child(5)]:w-[62%]")
                span
                span
                span
                span
                span
      elseif activeId === 'analytics' && analyticsState.rows === null
        section(className='grid min-h-[min(610px,70vh)] grid-cols-[minmax(260px,0.7fr)_minmax(420px,1.3fr)] items-center gap-[clamp(30px,6vw,90px)] overflow-hidden rounded-[18px] border border-[rgba(25,31,24,0.065)] bg-[#fcfdfb] p-[clamp(34px,6vw,82px)] max-[1050px]:grid-cols-[minmax(240px,0.8fr)_minmax(360px,1.2fr)] max-[1050px]:gap-[35px] max-[1050px]:px-[34px] max-[1050px]:py-11 max-[680px]:min-h-[560px] max-[680px]:grid-cols-1 max-[680px]:gap-8 max-[680px]:px-5 max-[680px]:pb-[30px] max-[680px]:pt-[38px]' aria-labelledby='analytics-stage-title')
          div(className='max-w-[440px]')
            p(className='mb-[11px] mt-0 text-[10px] font-extrabold uppercase tracking-[0.13em] text-[#889184]') Non-blocking analytics setup
            h2#analytics-stage-title(className='m-0 max-w-[440px] text-[clamp(28px,4vw,48px)] font-[590] leading-[1.02] tracking-[-0.055em] text-[#20241f]') #{analyticsState.phase === 'error' ? 'The analytics index needs another try' : 'The table shell stays interactive'}
            p(className='mb-0 mt-[18px] max-w-[390px] text-[13px] leading-[1.6] text-[#7c8379]') #{analyticsState.phase === 'error' ? 'Retry the cached source-row scan without reseeding Faker data.' : 'Source rows are reduced into cached market buckets in small chunks, with live progress above.'}
          div(className='rotate-[0.8deg] overflow-hidden rounded-[15px] border border-[#e2e6df] bg-white shadow-[0_22px_50px_rgba(40,49,37,0.08)] max-[680px]:w-[720px] max-[680px]:max-w-none' aria-hidden='true')
            div(className='grid min-h-10 grid-cols-[1.5fr_1fr_0.8fr_0.65fr_0.7fr] items-center gap-[18px] border-b border-[#edf0eb] bg-[#f5f7f3] px-[18px] [&_span]:block [&_span]:h-1.5 [&_span]:w-[56%] [&_span]:overflow-hidden [&_span]:rounded-full [&_span]:bg-[#dfe3dc]')
              span
              span
              span
              span
              span
            each row in placeholderRows key row
              div(className="grid min-h-[52px] grid-cols-[1.5fr_1fr_0.8fr_0.65fr_0.7fr] items-center gap-[18px] border-b border-[#edf0eb] px-[18px] last:border-b-0 [&_span]:block [&_span]:h-[7px] [&_span]:overflow-hidden [&_span]:rounded-full [&_span]:bg-[#e8ebe6] [&_span]:after:block [&_span]:after:h-full [&_span]:after:w-[45%] [&_span]:after:animate-pulse [&_span]:after:bg-[linear-gradient(90deg,transparent,rgba(255,255,255,0.85),transparent)] [&_span]:after:content-[''] [&_span:first-child]:h-2.5 [&_span:first-child]:w-[88%] [&_span:nth-child(2)]:w-[74%] [&_span:nth-child(3)]:w-[65%] [&_span:nth-child(4)]:w-[82%] [&_span:nth-child(5)]:w-[62%]")
                span
                span
                span
                span
                span
      else
        try
          if activeId === 'explorer'
            ExplorerTable(
              ~ rows={seedState.rows}
              ~ seedCount={seedCount}
              ~ seedDurationMs={seedState.elapsedMs}
              ~ onSeedCountChange={setSeedCount}
              ~ )
          elseif activeId === 'analytics'
            AnalyticsTable(
              ~ rows={analyticsState.rows}
              ~ sourceRowCount={seedState.rows.length}
              ~ indexDurationMs={analyticsState.elapsedMs}
              ~ )
          else
            StreamTable(rows={seedState.rows})
        pending
          section(
            ~ className='grid min-h-[min(610px,70vh)] place-items-center rounded-[18px] border border-[rgba(25,31,24,0.065)] bg-[#fcfdfb]'
            ~ aria-label='Loading table module'
            ~ role='status'
            ~ )
            div(className='grid justify-items-center gap-3 text-center')
              span(className='size-2 rounded-full bg-[#ff415a] animate-pulse motion-reduce:animate-none' aria-hidden='true')
              p(className='m-0 text-xs font-semibold text-muted-foreground') Loading table…
