import { createColumnHelper, flexRender, functionalUpdate, useTable } from '@octanejs/tanstack-table'
import type { PaginationState, SortingState } from '@octanejs/tanstack-table'
import { parseAsBoolean, parseAsInteger, parseAsString, parseAsStringLiteral, useQueryStates } from '@octanejs/nuqs'
import { useEffect, useMemo, useState, useRef, useLayoutEffect } from 'octane'
import { Badge, Button, Checkbox, HealthMeter, Input, Metric, Header } from './ui'
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from './ui/table'
import { formatCurrency, formatRelativeTime, prepareExplorerRows } from '../data'
import type { ExplorerProgress, PerformanceRow } from '../data'
import { explorerFeatures } from '../table-config'
import {gsap} from 'gsap'
import { useGSAP } from '@octanejs/gsap'
import { TABLE_QUERY_LIMITS } from './ui/table/hyper/Parsers'


module
  interface Props {
    rows: ReadonlyArray<PerformanceRow>
    seedDurationMs: number
  }

  interface QueryState {
    completed: number
    elapsedMs: number
    error: string | null
    matched: number
    phase: 'idle' | ExplorerProgress['phase'] | 'ready' | 'error'
    total: number
  }

  type RowIdAccessor<T extends RowData> = keyof T | ((row: T, index: number) => string | number | null | undefined)
  interface LocalDataState<T extends RowData> {
    source: T[]
    value: T[]
  }

  const UNSAFE_ROW_IDS = new Set(['__proto__', 'constructor', 'prototype'])

  const getFallbackRowIdValue = <T extends RowData>(row: T) => {
    if (!row || typeof row !== 'object') {
      return null
    }

    const record = row as Record<string, unknown>
    return record._id ?? record.id ?? record.visitorId ?? record.fid ?? null
  }

  const resolveRowId = <T extends RowData>(row: T, index: number, rowIdAccessor: RowIdAccessor<T> | undefined) => {
    const value =
      typeof rowIdAccessor === 'function'
        ? rowIdAccessor(row, index)
        : rowIdAccessor
          ? row[rowIdAccessor]
          : getFallbackRowIdValue(row)

    if (value === null || value === undefined) return String(index)

    const rowId = String(value)
    if (rowId.length === 0 || rowId.length > TABLE_QUERY_LIMITS.tokenCharacters || UNSAFE_ROW_IDS.has(rowId)) {
      throw new Error(
        `DataTable row id "${rowId.slice(0, 64)}" is empty, unsafe, or longer than ${TABLE_QUERY_LIMITS.tokenCharacters} characters.`
      )
    }
    return rowId
  }

  const columnHelper = createColumnHelper<typeof explorerFeatures, PerformanceRow>()
  const explorerSortIds = ['account', 'contact', 'email', 'region', 'status', 'revenue', 'health', 'updatedAt'] as const
  const explorerQueryParsers = {
    q: parseAsString.withDefault(''),
    page: parseAsInteger.withDefault(1),
    size: parseAsInteger.withDefault(15),
    sort: parseAsStringLiteral(explorerSortIds).withDefault('revenue'),
    desc: parseAsBoolean.withDefault(true),
  }
  const explorerPageSizes = [25, 100, 250, 1000]
  const columns = columnHelper.columns([
    columnHelper.display({
      id: 'select',
      header: 'Select',
      enableHiding: false,
      enableSorting: false,
    }),
    columnHelper.accessor('account', { header: 'Account', sortFn: 'text' }),
    columnHelper.accessor('contact', { header: 'Owner', sortFn: 'text' }),
    columnHelper.accessor('email', { header: 'Email', sortFn: 'text' }),
    columnHelper.accessor('region', { header: 'Region', sortFn: 'text' }),
    columnHelper.accessor('status', { header: 'Status', sortFn: 'text' }),
    columnHelper.accessor('revenue', { header: 'ARR', sortFn: 'basic' }),
    columnHelper.accessor('health', { header: 'Health', sortFn: 'basic' }),
    columnHelper.accessor('updatedAt', {
      header: 'Updated',
      sortFn: 'basic',
      enableGlobalFilter: false,
    }),
  ])

  const createInitialQueryState = (total: number): QueryState => ({
    completed: 0,
    elapsedMs: 0,
    error: null,
    matched: total,
    phase: 'idle',
    total,
  })

props { rows, seedDurationMs }: Props
setup
  const [{ q: globalFilter, page, size, sort, desc }, setExplorerQuery] = useQueryStates(
    explorerQueryParsers,
    { history: 'replace' },
  )
  const pageSize = explorerPageSizes.includes(size) ? size : 25
  const pagination = useMemo<PaginationState>(() => ({
    pageIndex: Math.max(0, page - 1),
    pageSize,
  }), [page, pageSize])
  const sorting = useMemo<SortingState>(() => [
    { id: sort, desc },
  ], [sort, desc])

  const [processedRows, setProcessedRows] = useState<ReadonlyArray<PerformanceRow>>(rows)
  const [queryState, setQueryState] = useState<QueryState>(() => createInitialQueryState(rows.length))
  const [draggedRowId, setDraggedRowId] = useState<string | null>(null)
  const [dropTarget, setDropTarget] = useState<{ position: RowDropPosition; rowId: string } | null>(null)
  const draggedRowIdRef = useRef<string | null>(null)
  const [enableRowReordering] = useState(true)
  const [loading] = useState(false)
  const [rowReorderPending, setRowReorderPending] = useState(false)
  const [bulkAction] = useState('idle')
  const [rowReorderDisabledReason] = useState<null>(null)
  const canReorderRows = enableRowReordering && !loading && !rowReorderPending && bulkAction === 'idle' && rowReorderDisabledReason === null
  const [rowIdAccessor] = useState<RowIdAccessor<PerformanceRow>>()
  const getTableRowId = useCallback((row: T, index: number) => resolveRowId(row, index, rowIdAccessor), [rowIdAccessor])
  const rowIds = useMemo(() => rows.map((row, index) => getTableRowId(row, index)), [getTableRowId, rows])
  const availableRowIds = useMemo(() => new Set(rowIds), [rowIds])
  const onRowReorder: (args: RowReorderArgs<T>) => void | Promise<void> = undefined
  const onRowReorderError: (error: unknown) => void = undefined
  const updateLocalData = useCallback(
    (updater: (current: T[]) => T[]) => {
      setLocalDataState((current) => {
        const currentValue = current?.source === rows ? current.value :rows
        return {
          source: rows,
          value: updater(currentValue)
        }
      })
    },
    [rows]
  )

  const clearRowDrag = useCallback(() => {
    draggedRowIdRef.current = null
    setDraggedRowId(null)
    setDropTarget(null)
  }, [])
  const handleRowDragStart = useCallback(
    (event: DragEvent<HTMLButtonElement>, rowId: string) => {
      if (!canReorderRows) {
        event.preventDefault()
        return
      }

      draggedRowIdRef.current = rowId
      setDraggedRowId(rowId)
      setDropTarget(null)
      event.dataTransfer.effectAllowed = 'move'
      event.dataTransfer.setData('text/plain', rowId)
    },
    [canReorderRows]
  )

  const handleRowDragOver = useCallback((event: DragEvent<HTMLTableRowElement>, rowId: string) => {
    const activeRowId = draggedRowIdRef.current

      if (!canReorderRows || !activeRowId || activeRowId === rowId) {
        return
      }

      event.preventDefault()
      event.dataTransfer.dropEffect = 'move'
      const position = getDropPosition(event)
      setDropTarget((current) =>
        current?.rowId === rowId && current.position === position ? current : { position, rowId }
      )
    },
    [canReorderRows]
  )

  const handleRowDrop = useCallback(
    (event: DragEvent<HTMLTableRowElement>, targetRowId: string) => {
      const activeRowId = draggedRowIdRef.current

      event.preventDefault()
      clearRowDrag()

      if (!canReorderRows || !activeRowId) {
        return
      }

      const result = reorderRows(rows, getTableRowId, activeRowId, targetRowId, getDropPosition(event))

      if (!result) {
        return
      }

      updateLocalData(() => result.rows)

      if (!onRowReorder) {
        return
      }

      setRowReorderPending(true)
      void Promise.resolve(onRowReorder(result))
        .catch((error: unknown) => {
          setLocalDataState(null)
          onRowReorderError?.(error)
        })
        .finally(() => setRowReorderPending(false))
    },
    [canReorderRows, clearRowDrag, getTableRowId, onRowReorder, onRowReorderError, rows, updateLocalData]
  )

  useEffect(() => {
    const controller = new AbortController()
    let queryTimer: number | undefined

    setQueryState(createInitialQueryState(rows.length))
    queryTimer = globalThis.setTimeout(() => {
      prepareExplorerRows(rows, {
        query: globalFilter,
        sorting,
        signal: controller.signal,
        onProgress: (progress) => {
          setQueryState({
            ...progress,
            error: null,
          })
        },
      })
        .then((result) => {
          if (controller.signal.aborted) return

          setProcessedRows(result.rows)
          setQueryState({
            completed: result.rows.length,
            elapsedMs: result.elapsedMs,
            error: null,
            matched: result.rows.length,
            phase: 'ready',
            total: result.rows.length,
          })
        })
        .catch((error: unknown) => {
          if (controller.signal.aborted) return

          setQueryState((current) => ({
            ...current,
            error: error instanceof Error ? error.message : 'The explorer index could not be updated.',
            phase: 'error',
          }))
        })
    }, globalFilter.trim().length > 0 ? 160 : 0)

    return () => {
      controller.abort()
      if (queryTimer !== undefined) globalThis.clearTimeout(queryTimer)
    }
  }, [rows, globalFilter, sorting])

  const pageRows = useMemo(() => {
    const pageStart = pagination.pageIndex * pagination.pageSize
    return processedRows.slice(pageStart, pageStart + pagination.pageSize)
  }, [processedRows, pagination.pageIndex, pagination.pageSize])

  const rowMotionRootRef = useRef<HTMLTableSectionElement>(null)

  useLayoutEffect(() => {
      const root = rowMotionRootRef.current

      if (!enableRowReordering || !root) {
        return
      }

      const rows = gsap.utils.toArray<HTMLTableRowElement>('[data-reorder-row-id]', root)

      if (rows.length === 0) {
        return
      }

      const prefersReducedMotion =
        typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (prefersReducedMotion) {
        gsap.set(rows, { clearProps: 'transform,opacity' })
        return
      }

      const activeIndex = draggedRowId ? rows.findIndex((row) => row.dataset.reorderRowId === draggedRowId) : -1
      const targetIndex = dropTarget ? rows.findIndex((row) => row.dataset.reorderRowId === dropTarget.rowId) : -1

      gsap.killTweensOf(rows)

      for (const [rowIndex, row] of rows.entries()) {
        const isDraggedRow = rowIndex === activeIndex
        const y =
          draggedRowId && dropTarget
            ? getRowDragOffset({
                activeIndex,
                rowIndex,
                targetIndex
              })
            : 0

        gsap.to(row, {
          y,
          scale: isDraggedRow ? 1.012 : y === 0 ? 1 : 0.998,
          opacity: isDraggedRow ? 0.82 : 1,
          duration: isDraggedRow ? 0.16 : 0.22,
          ease: 'power2.out',
          overwrite: true,
          clearProps: draggedRowId ? undefined : 'transform,opacity'
        })
      }

      return () => {
        gsap.killTweensOf(rows)
      }
    }, [draggedRowId, dropTarget, enableRowReordering])

  const table = useTable(
    {
      key: 'account-explorer',
      features: explorerFeatures,
      data: pageRows,
      columns,
      globalFilterFn: 'includesString',
      getColumnCanGlobalFilter: (column) => column.id !== 'select' && column.id !== 'updatedAt',
      getRowId: (row) => row.id,
      manualFiltering: true,
      manualPagination: true,
      manualSorting: true,
      rowCount: processedRows.length,
      state: {
        globalFilter,
        pagination,
        sorting,
      },
      onGlobalFilterChange: (updater) => {
        const nextFilter = String(functionalUpdate(updater, globalFilter) ?? '')
        void setExplorerQuery({ q: nextFilter, page: 1 })
      },
      onPaginationChange: (updater) => {
        const nextPagination = functionalUpdate(updater, pagination)
        void setExplorerQuery({
          page: nextPagination.pageIndex + 1,
          size: nextPagination.pageSize,
        })
      },
      onSortingChange: (updater) => {
        const nextSorting = functionalUpdate(updater, sorting)[0]
        void setExplorerQuery({
          sort: nextSorting?.id ?? 'revenue',
          desc: nextSorting?.desc ?? true,
          page: 1,
        })
      },
      initialState: {
        columnVisibility: { email: false },
      },
    },
    (state) => ({
      globalFilter: state.globalFilter,
      pagination: state.pagination,
      rowSelection: state.rowSelection,
      sorting: state.sorting,
    }),
  )
  const modelStartedAt = performance.now()
  const visibleRows = table.getRowModel().rows
  const modelDurationMs = performance.now() - modelStartedAt
  const filteredCount = processedRows.length
  const selectedCount = Object.keys(table.state.rowSelection).length
  const query = globalFilter
  const isQuerying = queryState.phase === 'filtering' || queryState.phase === 'sorting'
  const queryPercent = queryState.total === 0
    ? 0
    : Math.min(100, (queryState.completed / queryState.total) * 100)
  const queryLabel = queryState.phase === 'sorting' ? 'Ranking' : 'Searching'

section(className='relative rounded-[0.92em] border border-input/70 bg-background shadow-[0_1px_2px_rgba(28,34,26,0.04)] max-[680px]:rounded-[14px]' aria-labelledby='explorer-heading')
  div(className='absolute -top-2 -left-2 rounded-l-full border-r border-input/70 bg-muted w-4 h-4 rotate-45')
  div(className='absolute -top-2 -right-2 rounded-r-full border-l border-input/70 bg-muted w-4 h-4 -rotate-45')
  div(className='absolute -bottom-2 -right-2 rounded-b-full border-t border-input/70 bg-muted w-4 h-4 -rotate-45')
  div(className='absolute -bottom-2 -left-2 rounded-l-full border-r border-input/70 bg-muted w-4 h-4 -rotate-45')

  Header(eyebrow='Search + sort + select' title='Account Explorer' description='Scan, rank, and select across the full seeded dataset. Only the active page reaches the table model and DOM.')
    div(className='flex max-w-[530px] border border-input/50 rounded-sm p-1' aria-label='Performance metrics')
      span(className='font-mono text-muted-foreground text-2xs') #{rows.length.toLocaleString()} rows
      // Metric(value={rows.length.toLocaleString()} label='rows')

  div(className='flex min-h-12 items-center justify-between gap-4 px-4 pb-3 max-[680px]:flex-col max-[680px]:items-start')
    label(className='relative flex w-[min(100%,410px)] items-center max-[680px]:w-full')
      span(className='absolute -m-px size-px overflow-hidden whitespace-nowrap border-0 p-0 [clip:rect(0,0,0,0)]') Search all accounts
      Input(
        ~ type='search'
        ~ className='py-0 px-3'
        ~ value={query}
        ~ placeholder='Search account, owner, region…'
        ~ onInput={(event) => table.setGlobalFilter((event.currentTarget as HTMLInputElement).value)}
        ~ )
    div(className='flex items-center gap-2.5 text-xs text-muted-foreground max-[680px]:flex-wrap')
      if isQuerying
        span(className='inline-flex items-center gap-[9px]')
          span(className='font-mono tabular-nums text-orange-500 min-w-28' role='status')
            span #{queryLabel} &nbsp;
            span(className='px-1.5' aria-hidden='true') #{queryPercent.toFixed(0)}%
          span(className='text-[#bbc0b8]' aria-hidden='true') ·
      elseif queryState.phase === 'error'
        span(className='inline-flex items-center gap-[9px]')
          span(className='font-mono tabular-nums text-[#ca594b]' role='status') Index interrupted
          span(className='text-[#bbc0b8]' aria-hidden='true') ·
      if (query)
        span #{filteredCount.toLocaleString()} results
      span(className='text-[#bbc0b8]' aria-hidden='true') ·
      span #{selectedCount} selected

  div(className='border-t border-input/50')
    div(className='max-h-[min(590px,63vh)] w-full overflow-auto scrollbar-track-sidebar scrollbar-thumb-octane scrollbar-thin scroll-smooth')
      Table(className='min-w-[1180px]')
        TableHeader
          each headerGroup in table.getHeaderGroups() key headerGroup.id
            TableRow
              each header in headerGroup.headers key header.id
                TableHead(
                  ~ className={header.column.id === 'select' ? 'w-12 pr-2! pl-[18px]! text-center!' : ''}
                  ~ scope='col'
                  ~ )
                  if header.column.id === 'select'
                    Checkbox(
                      ~ aria-label='Select all rows on this page'
                      ~ checked={table.getIsAllPageRowsSelected()}
                      ~ onChange={table.getToggleAllPageRowsSelectedHandler()}
                      ~ )
                  else
                    Button(
                      ~ type='button'
                      ~ variant='ghost'
                      ~ size='none'
                      ~ className='inline-flex w-full cursor-pointer items-center gap-1.5 border-0 bg-transparent px-0 py-[5px] text-left text-[inherit] [font-weight:inherit] uppercase tracking-[inherit] disabled:cursor-default'
                      ~ disabled={!header.column.getCanSort()}
                      ~ onClick={header.column.getToggleSortingHandler()}
                      ~ )
                      span #{header.isPlaceholder ? '' : flexRender(header.column.columnDef.header, header.getContext())}
                      span(className='text-2xs text-muted-foreground' aria-hidden='true') #{header.column.getIsSorted() === 'asc' ? '↑' : header.column.getIsSorted() === 'desc' ? '↓' : '↕'}
        TableBody(ref={rowMotionRootRef})
          each row in visibleRows key row.id
            TableRow(className={row.getIsSelected() ? 'bg-sidebar!' : ''})
              each cell in row.getVisibleCells() key cell.id
                TableCell(className={cell.column.id === 'select' ? 'w-12 pr-2! pl-[18px]! text-center!' : cell.column.id === 'revenue' || cell.column.id === 'health' ? 'text-right' : ''})
                  if cell.column.id === 'select'
                    Checkbox(
                      ~ aria-label={`Select ${row.original.account}`}
                      ~ checked={row.getIsSelected()}
                      ~ onChange={row.getToggleSelectedHandler()}
                      ~ )
                  elseif cell.column.id === 'account'
                    div(className='flex min-w-0 items-center gap-2.5')
                      span(className='grid size-[32px] shrink-0 place-items-center rounded-sm border border-input/50 bg-sidebar text-xs font-semibold tracking-normal text-muted-foreground' aria-hidden='true') #{row.original.account.slice(0, 2).toUpperCase()}
                      div(className='[&_b]:block [&_b]:max-w-[230px] [&_b]:overflow-hidden [&_b]:text-ellipsis [&_b]:text-[11px] [&_b]:font-bold [&_b]:tracking-[-0.015em] [&_b]:text-[#242824] [&_small]:block [&_small]:max-w-[230px] [&_small]:overflow-hidden [&_small]:text-ellipsis [&_small]:font-mono [&_small]:text-[8px] [&_small]:tracking-[0.01em] [&_small]:text-[#969c93]')
                        b #{row.original.account}
                        small #{row.original.id}
                  elseif cell.column.id === 'contact'
                    div(className='grid min-w-0 items-center gap-[3px] [&_b]:block [&_b]:max-w-[230px] [&_b]:overflow-hidden [&_b]:text-ellipsis [&_b]:text-[11px] [&_b]:font-bold [&_b]:tracking-[-0.015em] [&_b]:text-[#242824] [&_small]:block [&_small]:max-w-[230px] [&_small]:overflow-hidden [&_small]:text-ellipsis [&_small]:font-mono [&_small]:text-[8px] [&_small]:tracking-[0.01em] [&_small]:text-[#969c93]')
                      b #{row.original.contact}
                  elseif cell.column.id === 'email'
                    small #{row.original.email}
                  elseif cell.column.id === 'region'
                    small #{row.original.region}
                  elseif cell.column.id === 'status'
                    Badge(tone={row.original.status === 'Healthy' ? 'success' : row.original.status === 'Watching' ? 'warning' : row.original.status === 'At risk' ? 'danger' : 'info'}) #{row.original.status}
                  elseif cell.column.id === 'revenue'
                    b(className='font-mono text-[10px] font-[680] tabular-nums text-[#303530]') #{formatCurrency(row.original.revenue)}
                  elseif cell.column.id === 'health'
                    HealthMeter(value={row.original.health})
                  elseif cell.column.id === 'updatedAt'
                    span(className='text-[#90968d]') #{formatRelativeTime(row.original.updatedAt)}
                  else
                    | #{String(cell.getValue() ?? '—')}
          empty
            TableRow
              TableCell(className='h-[300px]! text-center! text-[#8b9188]! [&_b]:mb-[7px] [&_b]:block [&_b]:text-sm [&_b]:text-[#454a43] [&_span]:block' colSpan={table.getVisibleLeafColumns().length})
                b No matching accounts
                span Try a shorter query or clear the search.

    footer(className='grid min-h-[50px] grid-cols-[1fr_auto_auto] items-center gap-5 border-t border-input/50 bg-sidebar px-4 py-[9px] text-[10px] font-semibold text-[#81877e] max-[680px]:grid-cols-[1fr_auto] [&_p]:m-0 [&_p:nth-child(2)]:text-center max-[680px]:[&_p:nth-child(2)]:hidden')
      div(className='flex items-center gap-2')
        label(for='explorer-page-size') Rows
        select#explorer-page-size(
          ~ className='h-8 rounded-md border border-input/50 bg-white py-0 pl-[9px] [&_svg]:ml-1 pr-2 text-[10px] text-[#555c53]'
          ~ value={String(table.state.pagination.pageSize)}
          ~ onChange={(event) => table.setPageSize(Number((event.currentTarget as HTMLSelectElement).value))}
          ~ )
          option(value='10') 10
          option(value='15') 15
          option(value='25') 25
          option(value='50') 50
      p(className='font-normal text-soft') Page #{table.state.pagination.pageIndex + 1} of #{Math.max(1, table.getPageCount()).toLocaleString()}
      div(className='flex items-center rounded-md border border-input/50 divide-x divide-input/50 bg-background overflow-hidden')
        Button(className='rounded-none disabled:opacity-40' variant='ghost' size='icon' aria-label='First page' disabled={!table.getCanPreviousPage()} onClick={() => table.firstPage()}) «
        Button(className='rounded-none disabled:opacity-40' variant='ghost' size='icon' aria-label='Previous page' disabled={!table.getCanPreviousPage()} onClick={() => table.previousPage()}) ‹
        Button(className='rounded-none disabled:opacity-40' variant='ghost' size='icon' aria-label='Next page' disabled={!table.getCanNextPage()} onClick={() => table.nextPage()}) ›
        Button(className='rounded-none disabled:opacity-40' variant='ghost' size='icon' aria-label='Last page' disabled={!table.getCanNextPage()} onClick={() => table.lastPage()}) »
