import {cn} from '@/lib/utils'
import {FlexRender} from '@octanejs/tanstack-table'
import type {Cell, RowData} from '@octanejs/tanstack-table'
import {features} from './Features'

module
  interface RenderCellProps<TData extends RowData, TValue> {
    cell: Cell<typeof features, TData, TValue>
    isEditing: boolean
    isVisible: boolean
    pinnedColumnLayout?: PinnedColumnLayout
  }

props {cell, isEditing, isVisible, pinnedColumnLayout}: RenderCellProps




td(
  ~ aria-hidden={!isVisible}
  ~ data-column-visible={isVisible}
  ~ data-column-pinned={pinnedColumnLayout?.position || undefined}
  ~ inert={!isVisible}
  ~ style={getPinnedColumnStyle(pinnedColumnLayout)}
  ~ className={cn('overflow-hidden p-0 [&:last-child>div]:py-0 border-border/50 first:border-l-0 border-dotted',
    ~ {
      ~ 'sticky z-10 bg-[#f5f6f7] dark:bg-[#1d212980] backdrop-blur-3xl transition-[inset-inline-start,inset-inline-end] duration-200 ease-out motion-reduce:transition-none': pinnedColumnLayout,
      ~ 'shadow-[4px_0_6px_-4px_hsl(var(--foreground)/0.25)]': pinnedColumnLayout?.isBoundary && pinnedColumnLayout.position === 'start',
      ~ 'shadow-[-4px_0_6px_-4px_hsl(var(--foreground)/0.25)]': pinnedColumnLayout?.isBoundary && pinnedColumnLayout.position === 'end',
      ~ 'dark:bg-background/10': isEditing && !pinnedColumnLayout,
      ~ 'pointer-events-none': !isVisible
      ~ })}
  ~ )
  div(className={cn('min-w-0 overflow-hidden p-3 transform-gpu transition-all duration-200 ease-out motion-reduce:transition-none origin-left opacity-0 scale-50',
    ~ {
      ~ 'opacity-100 scale-100': isVisible
      ~ })})
    FlexRender(cell={cell})
