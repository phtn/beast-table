import type { JSX } from 'octane/jsx-runtime'

module
  type NativeInputProps = JSX.IntrinsicElements['input']

  type Props = Omit<NativeInputProps, 'class' | 'className' | 'type'> & {
    className?: NativeInputProps['className']
  }

props { className, ...inputProps }: Props

input(
  ~ {...inputProps}
  ~ type='checkbox'
  ~ className={[
  ~   'm-0 size-[15px] cursor-pointer rounded border-[#cfd5cc] accent-[#20251f] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-[#6da5473d] focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50',
  ~   className,
  ~ ]}
  ~ )
