import type { JSX } from 'octane/jsx-runtime'

module
  type NativeInputProps = JSX.IntrinsicElements['input']

  type Props = Omit<NativeInputProps, 'class' | 'className' | 'type'> & {
    className?: NativeInputProps['className']
  }

props { className, ...inputProps }: Props

input(
  ~ {...inputProps}
  ~ type='checkbox'
  ~ className={[
  ~   'm-0 size-4 cursor-pointer rounded border-[#fafafa] focus-visible:outline-none focus-visible:ring-ring focus-visible:ring focus-visible:ring-offset-1 disabled:cursor-not-allowed disabled:opacity-50',
  ~   className,
  ~ ]}
  ~ )
