import type { JSX } from 'octane/jsx-runtime'
import Button from './Button.btsx'

module
  type NativeButtonProps = JSX.IntrinsicElements['button']

  type Props = Omit<NativeButtonProps, 'aria-checked' | 'children' | 'class' | 'className' | 'onClick' | 'role' | 'type'> & {
    checked: boolean
    children?: unknown
    className?: NativeButtonProps['className']
    onCheckedChange: (checked: boolean) => void
  }

props { checked, children, className, disabled = false, onCheckedChange, ...buttonProps }: Props

Button(
  ~ {...buttonProps}
  ~ type='button'
  ~ role='switch'
  ~ aria-checked={checked}
  ~ disabled={disabled}
  ~ variant='unstyled'
  ~ size='none'
  ~ className={[
  ~   'inline-flex h-[33px] items-center gap-2 rounded-[9px] border px-[11px] text-[9px] font-[750]',
  ~   checked ? 'border-[#aeca9b] bg-[#e9f4e2] text-[#426b2b]' : 'border-[#dde1da] bg-white text-[#646b61]',
  ~   className,
  ~ ]}
  ~ onClick={() => onCheckedChange(!checked)}
  ~ )
  span(className={`relative h-3.5 w-6 rounded-full transition-colors ${checked ? 'bg-[#72b34a]' : 'bg-[#c9cec5]'}`} aria-hidden='true')
    span(className={`absolute top-0.5 size-2.5 rounded-full bg-white shadow-sm transition-transform ${checked ? 'translate-x-3' : 'translate-x-0.5'}`})
  if children !== undefined
    span #{children}
