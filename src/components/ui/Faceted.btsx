import PopoverComponent, { PopoverTrigger, PopoverContent, PopoverTitle, PopoverDescription } from './Popover.btsx'
import type { PopoverTriggerProps } from './Popover.btsx'
import { createContext, useContext, useState, useRef, useCallback, useMemo, JSX } from 'octane'
import { cn } from '@/lib/utils'
import { JSX } from 'octane/jsx-runtime'


component FacetedTrigger
  props {className, children, ...triggerProps}: PopoverTriggerProps
  setup
    const context = useFacetedContext(TRIGGER_NAME)
    const composedRef = useComposedRefs(ref, context.triggerRef)
    const onPointerDown = composeEventHandlers(triggerProps.onPointerDown, (event) => {
      const target = event.target
      if (!(target instanceof Element)) return
      if (target.hasPointerCapture(event.pointerId)) {
        target.releasePointerCapture(event.pointerId)
      }
      // Only prevent default if we're not clicking on the input
      // This allows text selection in the input while still preventing focus stealing elsewhere
      if (
        event.button === 0 &&
        event.ctrlKey === false &&
        event.pointerType === 'mouse' &&
        !(event.target instanceof HTMLInputElement)
      ) {
        event.preventDefault()
      }
    )
  PopoverTrigger(
    ~ data-slot="faceted-trigger" { ...triggerProps }
    ~ ref={composedRef}
    ~ className={cn('justify-between focus:outline-none focus:ring-1 focus:ring-indigo-500 bg-background hover:bg-indigo-600/5', className)}
    ~ onPointerDown={onPointerDown})


component FacetedBadgeList
  props {ref, options = [], max = 2, placeholder = 'Select options', className, badgeClassName, ...badgeListProps} : FacetedBadgeListProps
  setup
    const context = useFacetedContext(BADGE_LIST_NAME)
    const values = Array.isArray(context.value) ? context.value : context.value ? [context.value] : []

    const getLabel = React.useCallback(
      (value: string) => {
        const option = options.find((opt) => opt.value === value)
        return option?.label ?? value
      },
      [options]
    )
  if values.length === 0
    div(data-slot="faceted-badge-list" { ...badgeListProps } ref={ref})
      span #{placeholder}
      // Icon(name='down' )
  else
    div(data-slot="faceted-badge-list" { ...badgeListProps } ref={ref} className={cn('flex items-center justify-between w-full font-okx', className)})
      if values.length > max
        Badge(variant='default' className={cn('rounded-sm font-normal', badgeClassName)}) #{values.length} selected
      else
        each value in values key value
          Badge(variant='secondary' className={cn('rounded-sm font-normal', badgeClassName)}) #{value}
            span(className='truncate') #{value ? getLabel(value) : value}

      // Icon(name='down' className='ml-auto size-3.5 opacity-80')


module
  const FACETED_NAME = 'Faceted'
  const TRIGGER_NAME = 'FacetedTrigger'
  const BADGE_LIST_NAME = 'FacetedBadgeList'
  const CONTENT_NAME = 'FacetedContent'
  const ITEM_NAME = 'FacetedItem'
  const ERRORS = {
    [FACETED_NAME]: `\`${FACETED_NAME}\` must be used as root component`,
    [TRIGGER_NAME]: `\`${TRIGGER_NAME}\` must be within \`${FACETED_NAME}\``,
    [BADGE_LIST_NAME]: `\`${BADGE_LIST_NAME}\` must be within \`${FACETED_NAME}\``,
    [CONTENT_NAME]: `\`${CONTENT_NAME}\` must be within \`${FACETED_NAME}\``,
    [ITEM_NAME]: `\`${ITEM_NAME}\` must be within \`${FACETED_NAME}\``
  }

  type FacetedValue<Multiple extends boolean> = Multiple extends true ? Array<string> : string
  type RefObject<T> = { current: T | null }

  interface FacetedContextValue<Multiple extends boolean = boolean> {
    triggerRef: RefObject<HTMLButtonElement | null>
    value?: FacetedValue<Multiple>
    onItemSelect?: (value: string) => void
    multiple?: Multiple
  }

  const FacetedContext = createContext<FacetedContextValue<boolean> | null>(null)
  function useFacetedContext(name: keyof typeof ERRORS) {
    const context = useContext(FacetedContext)
    if (!context) {
      throw new Error(ERRORS[name])
    }
    return context
  }

  type DivProps = JSX.IntrinsicElements['div']
  interface FacetedBadgeListProps extends DivProps {
    options?: Array<{ label: string; value: string }>
    max?: number
    badgeClassName?: string
    placeholder?: string
  }


  export {FacetedTrigger}


props { value, onValueChange, children, multiple = false as Multiple, ...facetedProps }: FacetedProps<Multiple>
setup
  const [isOpen, setOpen] = useState(open)
  const triggerRef = useRef<HTMLButtonElement>(null)
  const onItemSelect = useCallback(
    (selectedValue: string) => {
      if (!onValueChange) return

      if (multiple) {
        const currentValue: Array<string> = Array.isArray(value) ? value : []
        const newValue = currentValue.includes(selectedValue)
          ? currentValue.filter((v) => v !== selectedValue)
          : [...currentValue, selectedValue]
        onValueChange(newValue as FacetedValue<Multiple>)
      } else {
        if (value === selectedValue) {
          onValueChange(undefined)
        } else {
          onValueChange(selectedValue as FacetedValue<Multiple>)
        }

        requestAnimationFrame(() => {
          setOpen(false)
        })
      }
    },
    [multiple, onValueChange, value]
  )

  const contextValue = useMemo<FacetedContextValue<Multiple>>(() => ({ value, onItemSelect, multiple, triggerRef }),
    [value, onItemSelect, multiple]
  )
FacetedContext.Provider(value={contextValue})
  PopoverComponent( open={open} onOpenChange={setOpen} {...facetedProps})
  | #{children}
