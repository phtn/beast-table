import { createColumnHelper, flexRender, functionalUpdate, useTable } from '@octanejs/tanstack-table'
import type { GroupingState, PaginationState, SortingState } from '@octanejs/tanstack-table'
import { parseAsBoolean, parseAsInteger, parseAsStringLiteral, useQueryStates } from '@octanejs/nuqs'
import { useMemo } from 'octane'
import { Button, HealthMeter, Metric } from './ui'
import { formatCompact, formatCurrency } from '../data'
import type { AnalyticsRow } from '../data'
import { analyticsFeatures } from '../table-config'

module
  interface Props {
    indexDurationMs: number
    rows: ReadonlyArray<AnalyticsRow>
    sourceRowCount: number
  }

  const columnHelper = createColumnHelper<typeof analyticsFeatures, AnalyticsRow>()
  const analyticsSortIds = ['region', 'industry', 'accounts', 'revenue', 'seats', 'healthTotal'] as const
  const analyticsQueryParsers = {
    region: parseAsBoolean.withDefault(true),
    industry: parseAsBoolean.withDefault(true),
    page: parseAsInteger.withDefault(1),
    sort: parseAsStringLiteral(analyticsSortIds).withDefault('revenue'),
    desc: parseAsBoolean.withDefault(true),
  }
  const columns = columnHelper.columns([
    columnHelper.accessor('region', { header: 'Region', sortFn: 'text' }),
    columnHelper.accessor('industry', { header: 'Industry', sortFn: 'text' }),
    columnHelper.accessor('accounts', {
      header: 'Accounts',
      sortFn: 'basic',
      aggregationFn: 'sum',
    }),
    columnHelper.accessor('revenue', {
      header: 'Total ARR',
      sortFn: 'basic',
      aggregationFn: 'sum',
    }),
    columnHelper.accessor('seats', {
      header: 'Seats',
      sortFn: 'basic',
      aggregationFn: 'sum',
    }),
    columnHelper.accessor('healthTotal', {
      header: 'Avg. health',
      sortFn: 'basic',
      aggregationFn: 'sum',
    }),
  ])

props { indexDurationMs, rows, sourceRowCount }: Props
setup
  const [{ region, industry, page, sort, desc }, setAnalyticsQuery] = useQueryStates(
    analyticsQueryParsers,
    { history: 'replace' },
  )
  const grouping = useMemo<GroupingState>(() => [
    ...(region ? ['region'] : []),
    ...(industry ? ['industry'] : []),
  ], [region, industry])
  const pagination = useMemo<PaginationState>(() => ({
    pageIndex: Math.max(0, page - 1),
    pageSize: 18,
  }), [page])
  const sorting = useMemo<SortingState>(() => [
    { id: sort, desc },
  ], [sort, desc])

  const table = useTable(
    {
      key: 'grouped-analytics',
      features: analyticsFeatures,
      data: rows,
      columns,
      getRowId: (row) => row.id,
      groupedColumnMode: 'reorder',
      paginateExpandedRows: true,
      state: {
        grouping,
        pagination,
        sorting,
      },
      onGroupingChange: (updater) => {
        const nextGrouping = functionalUpdate(updater, grouping)
        void setAnalyticsQuery({
          region: nextGrouping.includes('region'),
          industry: nextGrouping.includes('industry'),
          page: 1,
        })
      },
      onPaginationChange: (updater) => {
        const nextPagination = functionalUpdate(updater, pagination)
        void setAnalyticsQuery({ page: nextPagination.pageIndex + 1 })
      },
      onSortingChange: (updater) => {
        const nextSorting = functionalUpdate(updater, sorting)[0]
        void setAnalyticsQuery({
          sort: nextSorting?.id ?? 'revenue',
          desc: nextSorting?.desc ?? true,
          page: 1,
        })
      },
      initialState: {
        expanded: false,
      },
    },
    (state) => ({
      expanded: state.expanded,
      grouping: state.grouping,
      pagination: state.pagination,
      sorting: state.sorting,
    }),
  )
  const modelStartedAt = performance.now()
  const visibleRows = table.getRowModel().rows
  const modelDurationMs = performance.now() - modelStartedAt
  const totalAccounts = table.getColumn('accounts').getAggregationValue<number>()
  const totalRevenue = table.getColumn('revenue').getAggregationValue<number>()
  const totalSeats = table.getColumn('seats').getAggregationValue<number>()
  const regionColumn = table.getColumn('region')
  const industryColumn = table.getColumn('industry')
  const isExpanded = table.getIsSomeRowsExpanded() || table.getIsAllRowsExpanded()

section(className='overflow-hidden rounded-[18px] border border-[rgba(25,31,24,0.065)] bg-[#fcfdfb] shadow-[0_1px_2px_rgba(28,34,26,0.04)] max-[680px]:rounded-[14px]' aria-labelledby='analytics-heading')
  header(className='flex items-start justify-between gap-7 px-[clamp(20px,3vw,38px)] pb-[26px] pt-[clamp(24px,3vw,38px)] max-[1050px]:flex-col max-[680px]:gap-5 max-[680px]:px-[18px] max-[680px]:pb-[22px] max-[680px]:pt-[25px]')
    div
      p(className='mb-[11px] mt-0 text-[10px] font-extrabold uppercase tracking-[0.13em] text-[#889184]') Group + aggregate + expand
      h2#analytics-heading(className='m-0 text-[clamp(26px,3.5vw,42px)] font-[590] leading-none') Portfolio Analytics
      p(className='mb-0 mt-1.5 max-w-[700px] text-[13px] leading-[1.55] text-[#747b72]') Index #{sourceRowCount.toLocaleString()} source records into #{rows.length.toLocaleString()} cached market buckets, then regroup the summary instantly.
    div(className='flex max-w-[530px] shrink-0 flex-wrap justify-end gap-[7px] max-[1050px]:justify-start max-[680px]:grid max-[680px]:w-full max-[680px]:grid-cols-3' aria-label='Portfolio totals')
      Metric(value={formatCurrency(totalRevenue)} label='total ARR')
      Metric(value={formatCompact(totalSeats)} label='seats')
      Metric(value={`${indexDurationMs.toFixed(0)}ms`} label='indexed' accent)

  div(className='flex min-h-16 items-center justify-between gap-[18px] border-t border-[#eef0ec] bg-[#f8f9f7] px-4 py-[11px] max-[1050px]:flex-col max-[1050px]:items-start max-[680px]:items-start')
    div(className='flex items-center gap-[9px] text-[11px] font-semibold text-[#7c8379] max-[680px]:flex-wrap' aria-label='Grouping columns')
      span(className='mr-0.5 text-[#979d94]') Group by
      Button(
        ~ type='button'
        ~ variant='unstyled'
        ~ size='none'
        ~ aria-pressed={regionColumn.getIsGrouped()}
        ~ className={`h-[33px] cursor-pointer rounded-[9px] border px-[11px] text-[9px] font-[750] hover:border-[#cbd1c8] hover:bg-[#f2f5f0] ${regionColumn.getIsGrouped() ? 'border-[#bfcdb6] bg-[#eaf2e5] text-[#4c673c] shadow-[inset_0_0_0_1px_rgba(116,153,89,0.06)]' : 'border-[#dde1da] bg-white text-[#646b61]'}`}
        ~ onClick={regionColumn.getToggleGroupingHandler()}
        ~ ) Region
      Button(
        ~ type='button'
        ~ variant='unstyled'
        ~ size='none'
        ~ aria-pressed={industryColumn.getIsGrouped()}
        ~ className={`h-[33px] cursor-pointer rounded-[9px] border px-[11px] text-[9px] font-[750] hover:border-[#cbd1c8] hover:bg-[#f2f5f0] ${industryColumn.getIsGrouped() ? 'border-[#bfcdb6] bg-[#eaf2e5] text-[#4c673c] shadow-[inset_0_0_0_1px_rgba(116,153,89,0.06)]' : 'border-[#dde1da] bg-white text-[#646b61]'}`}
        ~ onClick={industryColumn.getToggleGroupingHandler()}
        ~ ) Industry
    div(className='flex items-center gap-[9px] text-[11px] font-semibold text-[#7c8379] max-[1050px]:w-full max-[1050px]:flex-wrap')
      span #{formatCompact(totalAccounts)} accounts · #{rows.length.toLocaleString()} cached buckets
      Button(
        ~ type='button'
        ~ size='sm'
        ~ onClick={() => table.toggleAllRowsExpanded(!isExpanded)}
        ~ ) #{isExpanded ? 'Collapse groups' : 'Expand groups'}

  div(className='border-t border-[#e8ebe6]')
    div(className='max-h-[min(590px,63vh)] w-full overflow-auto [scrollbar-color:#c7ccc4_transparent] [scrollbar-width:thin]')
      table(className='w-full min-w-[980px] table-auto border-separate border-spacing-0 whitespace-nowrap [&_th]:sticky [&_th]:top-0 [&_th]:z-[2] [&_th]:h-[42px] [&_th]:border-b [&_th]:border-[#e4e7e2] [&_th]:bg-[rgba(246,248,244,0.96)] [&_th]:px-4 [&_th]:py-0 [&_th]:text-left [&_th]:text-[9px] [&_th]:font-extrabold [&_th]:uppercase [&_th]:tracking-[0.1em] [&_th]:text-[#7f867c] [&_th]:backdrop-blur-sm [&_td]:h-[55px] [&_td]:overflow-hidden [&_td]:border-b [&_td]:border-[#edf0eb] [&_td]:px-4 [&_td]:py-2 [&_td]:text-[11px] [&_td]:text-ellipsis [&_td]:text-[#50564e] [&_tbody_tr]:bg-[#fcfdfb] [&_tbody_tr]:transition-colors [&_tbody_tr]:duration-100 [&_tbody_tr:hover]:bg-[#f7f9f5] [&_tbody_tr:last-child_td]:border-b-0')
        thead
          each headerGroup in table.getHeaderGroups() key headerGroup.id
            tr
              each header in headerGroup.headers key header.id
                th(scope='col')
                  Button(
                    ~ type='button'
                    ~ variant='ghost'
                    ~ size='none'
                    ~ className='inline-flex w-full cursor-pointer items-center gap-1.5 border-0 bg-transparent px-0 py-[5px] text-left text-[inherit] [font-weight:inherit] uppercase tracking-[inherit] disabled:cursor-default'
                    ~ disabled={!header.column.getCanSort()}
                    ~ onClick={header.column.getToggleSortingHandler()}
                    ~ )
                    span #{header.isPlaceholder ? '' : flexRender(header.column.columnDef.header, header.getContext())}
                    if header.column.getIsGrouped()
                      span(className='rounded bg-[#dfebd7] px-1 py-0.5 font-mono text-[7px] tracking-normal text-[#577446]' aria-label='Grouped') G#{header.column.getGroupedIndex() + 1}
                    else
                      span(className='text-[10px] text-[#bdc2ba]' aria-hidden='true') #{header.column.getIsSorted() === 'asc' ? '↑' : header.column.getIsSorted() === 'desc' ? '↓' : '↕'}
        tbody
          each row in visibleRows key row.id
            tr(className={row.getIsGrouped() ? 'bg-[#f7faf5]! [&_td]:border-b-[#e4e9e1]' : ''})
              each cell in row.getAllCells() key cell.id
                td(className={cell.column.id === 'revenue' || cell.column.id === 'seats' || cell.column.id === 'accounts' || cell.column.id === 'healthTotal' ? 'text-right' : ''})
                  if cell.getIsGrouped()
                    Button(
                      ~ type='button'
                      ~ variant='ghost'
                      ~ size='none'
                      ~ className='inline-flex max-w-[250px] cursor-pointer items-center gap-[7px] border-0 bg-transparent p-0 text-[10px] text-[#303630] [&_b]:overflow-hidden [&_b]:text-ellipsis [&_small]:font-mono [&_small]:text-[8px] [&_small]:text-[#92998f]'
                      ~ style={{ paddingLeft: `${row.depth * 14}px` }}
                      ~ aria-expanded={row.getIsExpanded()}
                      ~ onClick={row.getToggleExpandedHandler()}
                      ~ )
                      span(className='grid size-[18px] shrink-0 place-items-center rounded-[5px] border border-[#d6dcd2] bg-white text-xs text-[#6b7664]' aria-hidden='true') #{row.getIsExpanded() ? '−' : '+'}
                      b #{String(cell.getValue())}
                      small #{formatCompact(Number(row.getValue('accounts')))} accounts
                  elseif cell.getIsAggregated()
                    b(className='font-mono text-[10px] font-[680] tabular-nums text-[#303530]')
                      if cell.column.id === 'revenue'
                        | #{formatCurrency(Number(cell.getValue()))}
                      elseif cell.column.id === 'accounts' || cell.column.id === 'seats'
                        | #{formatCompact(Number(cell.getValue()))}
                      else
                        | #{(Number(cell.getValue()) / Number(row.getValue('accounts'))).toFixed(0)}
                  elseif cell.getIsPlaceholder() || row.getIsGrouped()
                    span(className='text-[#d1d5ce]') —
                  elseif cell.column.id === 'healthTotal'
                    HealthMeter(value={row.original.healthTotal / row.original.accounts})
                  elseif cell.column.id === 'revenue'
                    b(className='font-mono text-[10px] font-[680] tabular-nums text-[#303530]') #{formatCurrency(row.original.revenue)}
                  elseif cell.column.id === 'accounts' || cell.column.id === 'seats'
                    span(className='font-mono text-[10px] font-[680] tabular-nums text-[#303530]') #{Number(cell.getValue()).toLocaleString()}
                  else
                    | #{String(cell.getValue() ?? '—')}
          empty
            tr
              td(className='h-[300px]! text-center! text-[#8b9188]! [&_b]:mb-[7px] [&_b]:block [&_b]:text-sm [&_b]:text-[#454a43] [&_span]:block' colSpan={table.getAllLeafColumns().length})
                b Add a grouping dimension
                span Select Region or Industry above to rebuild the grouped model.

    footer(className='grid min-h-[58px] grid-cols-[1fr_auto_1fr] items-center gap-[18px] border-t border-[#e8ebe6] bg-[#f8f9f7] px-4 py-[9px] text-[10px] font-semibold text-[#81877e] max-[680px]:grid-cols-[1fr_auto] [&_p]:m-0 [&_p:nth-child(2)]:text-center max-[680px]:[&_p:nth-child(2)]:hidden')
      p #{table.state.grouping.length} dimensions · #{visibleRows.length} DOM rows · #{modelDurationMs.toFixed(2)}ms model
      p Page #{table.state.pagination.pageIndex + 1} of #{Math.max(1, table.getPageCount()).toLocaleString()}
      div(className='flex justify-end gap-[5px]')
        Button(className='grid place-items-center text-[15px] leading-none disabled:opacity-40' size='icon' type='button' aria-label='Previous page' disabled={!table.getCanPreviousPage()} onClick={() => table.previousPage()}) ‹
        Button(className='grid place-items-center text-[15px] leading-none disabled:opacity-40' size='icon' type='button' aria-label='Next page' disabled={!table.getCanNextPage()} onClick={() => table.nextPage()}) ›
